# =================================================================
# DefectMind Backend Environment Configuration
# =================================================================

# Application Environment
ENV=production
DEBUG=False
PROJECT_NAME="Autonomous Software Defect Analysis & Multi-Agent Triage Engine"

# =================================================================
# Database Configuration (Supabase PostgreSQL or SQLite)
# =================================================================
# For Supabase PostgreSQL (Recommended for Online Render Deployment):
# Get this from: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Note: DefectMind automatically translates postgres:// or postgresql:// to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# For Local Offline SQLite Development (Default):
# DATABASE_URL=sqlite+aiosqlite:///./defect_engine.db

# =================================================================
# CORS Allowed Origins
# =================================================================
# Add your Vercel deployment URL here (comma-separated if multiple):
# e.g.: https://defectmind.vercel.app,http://localhost:3000
BACKEND_CORS_ORIGINS=https://*.vercel.app,http://localhost:3000

# =================================================================
# ChromaDB Vector Knowledge Base
# =================================================================
CHROMA_PERSIST_DIR=./chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# =================================================================
# Optional LLM API Key (OpenAI)
# =================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# =================================================================
# API Rate Limiting Configuration
# =================================================================
RATE_LIMIT_ENABLED=True
DEFAULT_RATE_LIMIT="60/minute"
SUBMISSION_RATE_LIMIT="15/minute"
SEARCH_RATE_LIMIT="30/minute"
ANALYTICS_RATE_LIMIT="30/minute"
